delimiter $$

create procedure contar()
begin 
  declare i int default 1;
  
  while i <= 10 do
    select i; 
    set i = i + 1;
  end while;
end $$

delimiter ;

call contar;


delimiter $$

create procedure AdicionarEstoque(
in p_nome varchar(100),
in p_preco decimal(10,2),
in p_estoque int,
in ip_quantidade int
)
begin 
  declare qtdAtual int;
  
  select quantidade
  into qtdAtual
  from estoque 
  where nome = p_nome;
  
  if qtdAtual is null then 
     insert into estoque (nome, preco, estoque, quantidade)
     values (p_produto, p_preco, p_estoque, ip_quantidade);
  else 
     update estoque 
     set  quantidade = quantidade + p_quantidade
     where nome = p_nome;
  end if;
end $$

delimiter ;

drop procedure AdicionarEstoque;

call AdicionarEstoque('Sapato', 499.99, 3, 1);

