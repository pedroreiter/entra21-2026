public class Celular {
   
    private String modelo;
    private int bateria;

    
    public Celular(String modelo) {
        this.modelo = modelo;
        this.bateria = 100; 
    }

    
    public void carregar() {
        bateria = 100;
        System.out.println("Celular carregado.");
    }

    
    public void usar(int percentual) {
        bateria -= percentual;

        if (bateria < 0) {
            bateria = 0;
        }

        System.out.println("Uso de " + percentual + "% da bateria.");
    }

   
    public void mostrarBateria() {
        System.out.println("Modelo: " + modelo);
        System.out.println("Bateria: " + bateria + "%");
    }

    
    public static void main(String[] args) {
        Celular celular = new Celular("Samsung Galaxy");

        celular.mostrarBateria();

        celular.usar(30);
        celular.mostrarBateria();

        celular.usar(70); 
        celular.mostrarBateria();

        celular.carregar();
        celular.mostrarBateria();
    }
}
