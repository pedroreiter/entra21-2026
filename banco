create table produtos (
id_produto int auto_increment primary key,
nome varchar(100), 
preco decimal (10,2),
estoque int );

rename table loja to produtos;

create table pedido (
id_pedido int auto_increment primary key, 
data_pedido date,
nome_cliente varchar(100) );

create table item_pedido (
id_item int auto_increment primary key,
id_pedido int, 
id_produto int, 
quantidade int, 
valor_unitario decimal(10,2) );

select
pr.nome as 'Produto',
pe.id_pedido as 'Pedido',
pe.nome_cliente as 'Cliente',
pe.data_pedido as 'Data',
ip.quantidade as 'Qtd',
ip.valor_unitario as 'Valor Unit.',
(ip.quantidade * ip.valor_unitario) as 'Subtotal'
from item_pedido ip
inner join produtos pr on ip.id_produto = pr.id_produto
inner join pedido pe on ip.id_pedido = pe.id_pedido
where pe.id_pedido = 2;

update item_pedido 
set quantidade = 3
where id_item = 2;
